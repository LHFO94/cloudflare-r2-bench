# Copy to terraform.tfvars and fill in. No secrets belong in this file:
# every credential comes from .env in the repo root, which the Makefile
# includes and exports. See .env.example.

# Short, unique, and never reused for a different R2 location. R2 pins a
# bucket name to its location permanently, so a reused id silently keeps the
# old region.
deployment_id = "aug20"

cloudflare_account_id = "1aeca2f2fd756d1dad2398a75a92c880"

# Workers & Pages > Overview in the dashboard, without ".workers.dev".
workers_dev_subdomain = "luuk-dev"

gcp_project_id = "globalse-198312"

# us-west2 pairs with R2 "wnam" and has the verified vCPU and external IP
# quota for 8 x n2-standard-8. Changing this without changing r2_location in
# main.tf will fail the region-pairing precondition.
gcp_region = "us-west2"
gcp_zones  = ["us-west2-a", "us-west2-b", "us-west2-c"]

# R2 credentials are NOT set here. They would be committed, and tfvars is not
# encrypted. Put them in .env instead, unquoted:
#   TF_VAR_r2_access_key_id=...
#   TF_VAR_r2_secret_access_key=...
# There is no secret store in this design. Secret Manager would keep the
# credential off the VMs and out of Terraform state, but granting a VM read
# access needs roles/secretmanager.admin, which the SE groups do not hold on
# this project. So the credential does reach Terraform state and VM instance
# metadata: scope the R2 token to the r2bench-* buckets and rotate it after
# the run.
