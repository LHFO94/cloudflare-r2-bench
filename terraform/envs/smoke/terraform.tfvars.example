# Copy to terraform.tfvars and fill in. No secrets belong in this file:
# the Cloudflare API token comes from $CLOUDFLARE_API_TOKEN, and the R2
# credentials live in Secret Manager.

# Short, unique, and never reused for a different R2 location. R2 pins a
# bucket name to its location permanently, so a reused id silently keeps the
# old region.
deployment_id = "smoke1"

cloudflare_account_id = "5c02ecf03b49174c44394b56a7d39965"

# Workers & Pages > Overview in the dashboard, without ".workers.dev".
workers_dev_subdomain = "your-subdomain"

gcp_project_id = "globalse-198312"

# us-west2 pairs with R2 "wnam" and has the verified vCPU and external IP
# quota; the smoke run needs one n2-standard-2. Changing this without changing r2_location in
# main.tf will fail the region-pairing precondition.
gcp_region = "us-west2"
gcp_zones  = ["us-west2-a"]

# R2 credentials are NOT set here. They would be committed, and tfvars is not
# encrypted. Export them instead:
#   export TF_VAR_r2_access_key_id='...'
#   export TF_VAR_r2_secret_access_key='...'
# They still reach Terraform state and VM instance metadata, so scope the R2
# token to the r2bench-* buckets and rotate it after the run.
