/**
 * Control-plane Worker for the R2 load-test harness.
 *
 * Load generators are external VMs (see terraform/), not Cloudflare
 * Containers, so there is no container config, no Durable Object and no
 * spawn queue here. The Worker only hands out work to polling agents,
 * stores their metrics in D1 and serves the UI.
 *
 * For a deployed environment Terraform renders this file from
 * terraform/modules/control-plane/wrangler.jsonc.tftpl so that the Worker
 * name, D1 id and R2 account id match the environment being provisioned.
 * The values below are the local `wrangler dev` defaults.
 *
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "r2benchmark",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-06",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"assets": {
		"run_worker_first": ["/api/*", "/start"],
		"binding": "ASSETS",
		"directory": "./assets",
	},
	"vars": {
		"R2_ACCOUNT_ID": "1aeca2f2fd756d1dad2398a75a92c880",
		"DEPLOYMENT_AGENTS": "1",
		"MAX_WORKERS_PER_AGENT": "2048",
	},
	/**
	 * Reconciliation sweep. Agents push metrics, but nothing pushes when an
	 * agent dies, so a cron closes out expired jobs and marks stale spawns.
	 * Runs every minute, which is the finest granularity Cron Triggers offer.
	 */
	"triggers": {
		"crons": ["* * * * *"],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "DB",
			// Placeholder. `wrangler dev` works against a local D1 without it;
			// deployed environments use wrangler.generated.jsonc, where
			// Terraform substitutes the real id.
			"database_id": "00000000-0000-0000-0000-000000000000",
		},
	],
	/**
	 * Tombstone for the container supervisor Durable Object that this harness
	 * replaced. Required only when deploying over a Worker that previously ran
	 * the upstream container-based design; a no-op on a fresh Worker name.
	 */
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BenchmarkContainer"],
		},
		{
			"tag": "v2",
			"deleted_classes": ["BenchmarkContainer"],
		},
	],
	/**
	 * Secrets (set out of band, never committed):
	 *   AGENT_TOKEN - shared token presented by load-generator VMs
	 *   ADMIN_TOKEN - operator token for /api/v1/* and /start
	 * Locally, put them in .dev.vars (see .dev.vars.example).
	 */
}
