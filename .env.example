# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
# The Makefile includes this file and exports everything in it, so `make apply`
# and friends work identically in any shell without hunting for the terminal
# tab where you last ran `export`.
#
# FORMAT RULES - this file is parsed by GNU make, not by a shell:
#   - no quotes around values      GOOD: FOO=bar      BAD: FOO='bar'
#   - no spaces around the equals  GOOD: FOO=bar      BAD: FOO = bar
#   - '#' starts a comment
# Quotes would be taken literally and end up inside the value.

# ---------------------------------------------------------------------------
# Cloudflare
# ---------------------------------------------------------------------------
# Custom API token, ~40 chars. NOT the 64-hex R2 secret access key, and not
# your wrangler OAuth session - the Terraform provider cannot use either.
# Create at My Profile > API Tokens > Create Custom Token with these Account
# permissions: Workers R2 Storage:Edit, D1:Edit, Workers Scripts:Edit.
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# R2 S3 credentials
# ---------------------------------------------------------------------------
# From R2 > Manage API tokens > Create API token, Object Read & Write.
# Scope it to the r2bench-* buckets, which means creating the buckets first:
#   make tf-apply-r2
# These reach the VMs through instance metadata, so a bucket-scoped token is
# the difference between "someone trashes test fixtures" and "someone trashes
# production". Rotate after a run.
TF_VAR_r2_access_key_id=
TF_VAR_r2_secret_access_key=

# ---------------------------------------------------------------------------
# GCP
# ---------------------------------------------------------------------------
# Overrides the gcloud default account per-process, so a personal account left
# active in `gcloud config` cannot silently be used.
CLOUDSDK_CORE_ACCOUNT=luuk@cloudflare.com
CLOUDSDK_CORE_PROJECT=globalse-198312

# NOTE: this does NOT cover Terraform's Google provider, which authenticates
# with Application Default Credentials rather than gcloud config. If preflight
# reports the wrong ADC identity:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project globalse-198312

# ---------------------------------------------------------------------------
# Which environment `make` acts on
# ---------------------------------------------------------------------------
# smoke or standard. Override per-command with: make tf-apply ENV=standard
ENV=smoke
